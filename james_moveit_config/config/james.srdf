<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of James (beer crate + OpenManipulator-X) for MoveIt.

  Based on config/open_manipulator_x.srdf from open_manipulator_x_moveit_config by
  ROBOTIS CO., LTD. (https://github.com/ROBOTIS-GIT/open_manipulator, humble branch),
  licensed under the Apache License, Version 2.0 (see LICENSE-APACHE-2.0 in this package).
  Taken over: the gripper group, the named states init, home, open and close, the end
  effector, the passive joint and the disabled collision pairs of the arm.

  Modified for James by Tim Assman: the arm group is a chain, no virtual joint (the crate is
  the root link), collision pair between the crate and the arm base, named states for picking
  a bottle from the crate.
-->
<robot name="james">

  <group name="arm">
    <chain base_link="link1" tip_link="end_effector_link"/>
  </group>
  <group name="gripper">
    <joint name="gripper_left_joint"/>
    <joint name="gripper_right_joint"/>
  </group>

  <group_state name="init" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
  </group_state>
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="-1"/>
    <joint name="joint3" value="0.7"/>
    <joint name="joint4" value="0.3"/>
  </group_state>
  <!-- Bottle r2c2 between the fingers, taught by hand on the real arm (2026-10-09).
       Gripper pitch 54.7 deg below horizontal. -->
  <group_state name="grasp_r2c2" group="arm">
    <joint name="joint1" value="-3.0070"/>
    <joint name="joint2" value="-0.4372"/>
    <joint name="joint3" value="-0.0614"/>
    <joint name="joint4" value="1.4527"/>
  </group_state>
  <!-- Handing over a bottle: arm pointing away from the crate, forearm raised, joint4 such that
       the gripper pitch equals grasp_r2c2 (joint2 + joint3 + joint4 = 0.9541), so the bottle
       hangs upright. -->
  <group_state name="handover" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="1.7541"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_left_joint" value="0.019"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="gripper_left_joint" value="-0.01"/>
  </group_state>

  <end_effector name="gripper" parent_link="end_effector_link" group="gripper" parent_group="arm"/>

  <!-- Mimics gripper_left_joint -->
  <passive_joint name="gripper_right_joint"/>

  <disable_collisions link1="gripper_left_link" link2="gripper_right_link" reason="Never"/>
  <disable_collisions link1="gripper_left_link" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_left_link" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="gripper_right_link" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_right_link" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="crate" link2="link1" reason="Adjacent"/>

</robot>
